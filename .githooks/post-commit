#!/bin/sh
# コミットに .atb の変更が含まれていたら組版する。
#
# これは at-book が自動生成するものではなく、このリポジトリが自分で置いている
# 普通のシェルスクリプト。中身は自由に変えてよい（特定の作品だけ組む、
# バックグラウンドで走らせる、など）。
#
# at-book はカレントディレクトリ配下の at-book.config.json を再帰的に探し、
# autoGenerate に書かれた原稿をまとめて組む。
#
# --root が必要なのは、親を持たない最初のコミットでは diff-tree が
# 何も出力しないため（新規リポジトリの1回目が無反応になる）。

git diff-tree --no-commit-id -r --name-only --root HEAD | grep -q '\.atb$' || exit 0

# ローカル依存（npm i -D）とグローバル導入の両方に対応する。
if [ -x "./node_modules/.bin/at-book" ]; then
    ./node_modules/.bin/at-book
else
    at-book
fi
