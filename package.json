{
  "name": "at-book",
  "version": "1.0.0",
  "description": "日本語小説のための執筆記法「＠本」。.atb 原稿から縦書き PDF / EPUB / ウェブ投稿用テキストを生成する組版 CLI",
  "bin": {
    "at-book": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "setup": "npm run build && npm link && git config core.hooksPath .githooks",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuyukusado/at-book-release.git"
  },
  "keywords": [
    "novel",
    "japanese",
    "typesetting",
    "vertical-writing",
    "epub",
    "pdf",
    "vivliostyle",
    "atb"
  ],
  "author": "tsuyukusado",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/tsuyukusado/at-book-release/issues"
  },
  "homepage": "https://github.com/tsuyukusado/at-book-release#readme",
  "dependencies": {
    "@vivliostyle/cli": "^8.0.0",
    "archiver": "^5.3.2",
    "node-stream-zip": "^1.15.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
